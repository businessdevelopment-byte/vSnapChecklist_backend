DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME"
PORT=4000
NODE_ENV=development
JWT_SECRET=your-super-secret-jwt-key-must-be-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
CORS_ORIGINS=http://localhost:3000,http://192.168.1.22:3000

# COOKIE_DOMAIN (optional): set this in production ONLY if the frontend and
# backend are deployed on different subdomains of the same site (e.g.
# frontend on cl.example.com, backend on api.example.com) — set it to
# ".example.com" so the refreshToken/accessToken cookies are valid on both.
# Leave unset for local dev.
# COOKIE_DOMAIN=.example.com

# File upload storage path (absolute system path, works on Windows and Linux)
# Optional: falls back to "uploads" directory in the backend root if not provided
# UPLOAD_DIR="C:/path/to/custom/uploads"
# UPLOAD_DIR="/var/www/uploads"
