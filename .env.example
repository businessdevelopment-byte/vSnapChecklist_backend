DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME"
PORT=4000
NODE_ENV=development
JWT_SECRET=your-super-secret-jwt-key-must-be-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=6h
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
CORS_ORIGINS=http://localhost:3000,http://192.168.1.22:3000

# COOKIE_DOMAIN (optional): Domain attribute for the refreshToken/accessToken
# cookies. Only this backend ever reads them (the frontend has no server-side
# middleware), so scope it to the API host — prod uses
# ".botivateapi.vsnapu.com". A parent domain like ".example.com" would send
# the tokens to every sibling subdomain. Leave unset for local dev.
# COOKIE_DOMAIN=.api.example.com

# Legacy MIS Google Sheet shown on MIS → Google Sheet (read-only; optional,
# defaults to "New Mis Summary V.01" and its "For Records" tab).
# MIS_APPS_SCRIPT_URL: the sheet's Apps Script web app (…/macros/s/<id>/exec),
# read with ?sheet=For Records. Preferred source. If unset or failing, the
# tab's CSV export is used instead, which needs the sheet shared as
# "Anyone with the link can view". Keep the real script URL out of git.
# MIS_SHEET_ID=1H8mSp4YEUxKQC7dIKTj0hNcpIWf1gpLJh2BIt2WhGiQ
# MIS_SHEET_FOR_RECORDS_GID=39144063
# MIS_APPS_SCRIPT_URL=https://script.google.com/macros/s/<deployment-id>/exec

# Nightly Checklist & Delegation → Google Sheet mirror (Settings → Google Sheet
# Sync). Off unless SHEET_SYNC_URL and SHEET_SYNC_SECRET are both set. Setup
# steps are at the top of scripts/sheet-sync/Code.gs. Set
# SHEET_SYNC_ENABLED=false on any machine that must not write the sheet
# (e.g. a dev copy), so only production syncs it.
# SHEET_SYNC_URL=https://script.google.com/macros/s/<deployment-id>/exec
# SHEET_SYNC_SECRET=<same long random value as SYNC_SECRET in the script, 32+ chars>
# SHEET_SYNC_ENABLED=true
# SHEET_SYNC_TIME=23:45
# SHEET_SYNC_SPREADSHEET_ID=1pwd6iLpSQ0nncoc99vZCjo9WWgHcWWWmhNG5xQ5uajI
# SHEET_SYNC_CHECKLIST_TAB=Checklist
# SHEET_SYNC_DELEGATION_TAB=Delegation

# File upload storage path (absolute system path, works on Windows and Linux)
# Optional: falls back to "uploads" directory in the backend root if not provided
# UPLOAD_DIR="C:/path/to/custom/uploads"
# UPLOAD_DIR="/var/www/uploads"
