generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                Int                 @id @default(autoincrement())
  username          String              @unique
  passwordHash      String
  email             String?             @unique
  role              Role                @default(USER)
  status            UserStatus          @default(ACTIVE)
  departmentId      Int?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  attendanceLogs    AttendanceLog[]
  checklistEntries  ChecklistEntry[]    @relation("EntryAssignedTo")
  transferredTo     ChecklistEntry[]    @relation("EntryTransferredTo")
  delegationHistory DelegationHistory[] @relation("HistorySubmittedBy")
  delegationTasks   DelegationTask[]    @relation("DelegationAssignedTo")
  templateTasks     TaskTemplate[]      @relation("TemplateAssignedTo")
  transfersFrom     TaskTransferLog[]   @relation("TransferFrom")
  transfersTo       TaskTransferLog[]   @relation("TransferTo")
  transferredBy     TaskTransferLog[]   @relation("TransferBy")
  departments       UserDepartment[]
  department        Department?         @relation(fields: [departmentId], references: [id])

  @@index([username])
  @@index([departmentId])
  @@map("users")
}

model Department {
  id               Int              @id @default(autoincrement())
  name             String           @unique
  givenBy          String?
  createdAt        DateTime         @default(now())
  checklistEntries ChecklistEntry[]
  delegationTasks  DelegationTask[]
  taskTemplates    TaskTemplate[]
  userLinks        UserDepartment[]
  users            User[]

  @@map("departments")
}

model UserDepartment {
  userId       Int
  departmentId Int
  assignedAt   DateTime   @default(now())
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, departmentId])
  @@index([userId])
  @@map("user_departments")
}

model TaskTemplate {
  id                Int              @id @default(autoincrement())
  taskCode          String           @unique
  departmentId      Int
  givenBy           String
  assignedUserId    Int
  description       String
  startDate         DateTime         @db.Date
  lastDate          DateTime?        @db.Date
  frequency         Frequency
  enableReminders   Boolean          @default(true)
  requireAttachment Boolean          @default(false)
  sampleImageUrl    String?
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  entries           ChecklistEntry[]
  assignedUser      User             @relation("TemplateAssignedTo", fields: [assignedUserId], references: [id])
  department        Department       @relation(fields: [departmentId], references: [id])

  @@index([assignedUserId, isActive])
  @@index([frequency, startDate])
  @@index([departmentId])
  @@map("task_templates")
}

model ChecklistEntry {
  id                BigInt            @id @default(autoincrement())
  templateId        Int?
  taskCode          String
  departmentId      Int
  givenBy           String
  assignedUserId    Int
  description       String
  taskStartDate     DateTime          @db.Date
  taskStartTime     String?
  frequency         Frequency
  enableReminders   Boolean           @default(true)
  requireAttachment Boolean           @default(false)
  sampleImageUrl    String?
  actualDate        DateTime?         @db.Date
  delayDays         Int?
  completionStatus  CompletionStatus?
  remarks           String?
  uploadedImageUrl  String?
  adminDone         Boolean           @default(false)
  leaveStatus       Boolean           @default(false)
  transferredToId   Int?
  remarks1          String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  assignedUser      User              @relation("EntryAssignedTo", fields: [assignedUserId], references: [id])
  department        Department        @relation(fields: [departmentId], references: [id])
  template          TaskTemplate?     @relation(fields: [templateId], references: [id])
  transferredTo     User?             @relation("EntryTransferredTo", fields: [transferredToId], references: [id])
  transferLogs      TaskTransferLog[]

  @@unique([templateId, taskStartDate])
  @@index([assignedUserId, taskStartDate])
  @@index([assignedUserId, taskStartDate, actualDate])
  @@index([taskStartDate, assignedUserId])
  @@index([departmentId, taskStartDate])
  @@index([templateId, taskStartDate])
  @@map("checklist_entries")
}

model DelegationTask {
  id                Int                 @id @default(autoincrement())
  taskCode          String              @unique
  departmentId      Int
  givenBy           String
  assignedUserId    Int
  description       String
  taskStartDate     DateTime
  frequency         DelegationFrequency
  enableReminders   Boolean             @default(true)
  requireAttachment Boolean             @default(false)
  sampleImageUrl    String?
  status            DelegationStatus    @default(PENDING)
  rating            Int?
  isDeleted         Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  taskEndDate       DateTime?
  history           DelegationHistory[]
  assignedUser      User                @relation("DelegationAssignedTo", fields: [assignedUserId], references: [id])
  department        Department          @relation(fields: [departmentId], references: [id])

  @@index([assignedUserId, status])
  @@index([taskStartDate, status])
  @@index([departmentId])
  @@index([assignedUserId, isDeleted, status])
  @@map("delegation_tasks")
}

model DelegationHistory {
  id                Int            @id @default(autoincrement())
  delegationTaskId  Int
  submittedByUserId Int
  submissionDate    DateTime       @db.Date
  status            HistoryStatus
  nextTargetDate    DateTime?      @db.Date
  remarks           String?
  imageUrl          String?
  taskDescription   String
  givenBy           String?
  adminDoneStatus   String?
  isLate            Boolean        @default(false)
  createdAt         DateTime       @default(now())
  delegationTask    DelegationTask @relation(fields: [delegationTaskId], references: [id], onDelete: Cascade)
  submittedBy       User           @relation("HistorySubmittedBy", fields: [submittedByUserId], references: [id])

  @@index([delegationTaskId])
  @@index([submittedByUserId, submissionDate])
  @@map("delegation_history")
}

model TaskTransferLog {
  id                  Int             @id @default(autoincrement())
  checklistEntryId    BigInt?
  templateId          Int?
  fromUserId          Int
  toUserId            Int
  transferredByUserId Int
  reason              String?
  transferredAt       DateTime        @default(now())
  checklistEntry      ChecklistEntry? @relation(fields: [checklistEntryId], references: [id])
  fromUser            User            @relation("TransferFrom", fields: [fromUserId], references: [id])
  toUser              User            @relation("TransferTo", fields: [toUserId], references: [id])
  transferredBy       User            @relation("TransferBy", fields: [transferredByUserId], references: [id])

  @@index([checklistEntryId])
  @@index([fromUserId, transferredAt])
  @@index([toUserId, transferredAt])
  @@map("task_transfer_logs")
}

model OtpJob {
  id                   Int         @id @default(autoincrement())
  jobId                String      @unique
  projectId            String      @unique
  client               String
  jobGenre             String
  customIdName         String?
  customId             String?
  salesExecutive       String
  jobDate              DateTime    @db.Date
  deliveryDate         DateTime    @db.Date
  jobTime              String
  pocName              String
  pocContact           String
  pocWhatsapp          String?
  pocEmail             String?
  poc2ndEmail          String?
  jobCity              String
  jobShootAddress      String
  jobSpecification     String?
  deliverables         String?
  packageAmount        Decimal     @db.Decimal(12, 2)
  operationsCost       Decimal     @db.Decimal(12, 2)
  taxableAmount        Decimal     @db.Decimal(12, 2)
  gst                  Decimal     @db.Decimal(12, 2)
  packageAmountWithTax Decimal     @db.Decimal(12, 2)
  isTokenReceived      Boolean     @default(false)
  currentStage         OtpJobStage @default(ORDER_RECEIVED)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  stageEvents          OtpStageEvent[]

  @@index([currentStage])
  @@index([jobDate])
  @@map("otp_jobs")
}

model OtpStageEvent {
  id        Int         @id @default(autoincrement())
  otpJobId  Int
  stage     OtpJobStage
  data      Json
  createdAt DateTime    @default(now())
  otpJob    OtpJob      @relation(fields: [otpJobId], references: [id], onDelete: Cascade)

  @@index([otpJobId])
  @@index([stage])
  @@map("otp_stage_events")
}

model PipelineJob {
  id               Int                  @id @default(autoincrement())
  pipelineType     PipelineType
  jobId            String               @unique
  projectId        String?
  client           String
  jobGenre         String?
  customIdName     String?
  customId         String?
  salesExecutive   String?
  jobDate          DateTime?            @db.Date
  deliveryDate     DateTime?            @db.Date
  jobTime          String?
  pocName          String?
  pocContact       String?
  pocWhatsapp      String?
  pocEmail         String?
  poc2ndEmail      String?
  jobCity          String?
  jobShootAddress  String?
  jobSpecification String?
  deliverables     String?
  currentStage     String
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  stageEvents      PipelineStageEvent[]

  @@index([pipelineType, currentStage])
  @@map("pipeline_jobs")
}

model PipelineStageEvent {
  id            Int         @id @default(autoincrement())
  pipelineJobId Int
  stage         String
  data          Json
  createdAt     DateTime    @default(now())
  pipelineJob   PipelineJob @relation(fields: [pipelineJobId], references: [id], onDelete: Cascade)

  @@index([pipelineJobId])
  @@index([stage])
  @@map("pipeline_stage_events")
}

model SystemSettings {
  id          Int     @id @default(1)
  skipSundays Boolean @default(true)

  @@map("system_settings")
}

model Holiday {
  id        Int      @id @default(autoincrement())
  date      DateTime @unique @db.Date
  name      String
  createdAt DateTime @default(now())

  @@map("holidays")
}

model AttendanceLog {
  id        BigInt   @id @default(autoincrement())
  userId    Int
  loginAt   DateTime @default(now())
  ipAddress String?
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, loginAt])
  @@map("attendance_logs")
}

enum Role {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum Frequency {
  DAILY
  ALTERNATE_DAY
  WEEKLY
  FORTNIGHTLY
  MONTHLY
  QUARTERLY
  YEARLY
  END_OF_1ST_WEEK
  END_OF_2ND_WEEK
  END_OF_3RD_WEEK
  END_OF_4TH_WEEK
  END_OF_LAST_WEEK
}

enum DelegationFrequency {
  ONE_TIME
  CRITICAL
  URGENT
}

enum DelegationStatus {
  PENDING
  PLANNED
  VERIFY_PENDING
  DONE
}

enum CompletionStatus {
  YES
  NO
  NOT_REQUIRED
  NOT_APPLICABLE
}

enum HistoryStatus {
  DONE
  EXTEND_DATE
}

enum OtpJobStage {
  ORDER_RECEIVED
  ASSIGN_MEMBER
  RE_CONFIRMATION
  PHOTOGRAPHER_ALLOTMENT
  PHOTOGRAPHER_SEARCH
  FINAL_PHOTOGRAPHER
  PHOTOGRAPHER_BRIEFING
  MAKE_TOKEN
  STORY_BRIEFING
  MOODBOARD_CREATION
  CLIENT_BRIEFING_BEFORE_SHOOT
  PHOTOGRAPHER_BRIEFING_BEFORE_SHOOT
  MOODBOARD_DELIVERY_TO_CLIENT
  COMPLETED
}

enum PipelineType {
  PMS
  POLITICAL
}
